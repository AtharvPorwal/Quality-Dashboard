JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=replace-with-read-only-token
JIRA_PROJECT_KEY=DD
# Comma-separated Jira spaces shown in the dashboard selector. The first is the default.
JIRA_SPACE_KEYS=DD,LP
# Jira custom fields used for PI and six-sprint analytics.
JIRA_PI_FIELD_ID=customfield_10074
JIRA_SPRINT_FIELD_ID=customfield_10075
ZEPHYR_API_BASE_URL=https://api.zephyrscale.smartbear.com/v2
ZEPHYR_API_TOKEN=replace-with-zephyr-token
